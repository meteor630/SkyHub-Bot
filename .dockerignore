# КРИТИЧНО: .env содержит настоящий токен бота -- без этого файла
# `COPY . .` в Dockerfile запекал бы токен прямо в слои образа. Даже
# если сам образ никуда не публикуется, слои с секретом остаются на
# диске сервера (docker history, экспорт образа) дольше, чем нужно, и
# доступны любому, у кого есть доступ к Docker на этой машине -- в
# обход .gitignore, который защищает только git (найдено при аудите
# безопасности).
.env
.env.*
!.env.example

.git/
.github/

__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ruff_cache
*.egg-info/
dist/
build/

# Данные приложения -- монтируются как volume в docker-compose.yml,
# в образе не нужны и не должны в него запекаться.
logs/
data/
*.jsonl

.DS_Store
README.md
docs/
