# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте .env в git.

# Токен Discord-бота (Портал разработчика -> Bot -> Token). Никогда не логировать.
DISCORD_TOKEN=

# postgresql+asyncpg://пользователь:пароль@хост:5432/имя_бд
# (для варианта "вручную" -- см. docs/DEPLOYMENT.md; для Docker вместо
# этой строки используйте POSTGRES_PASSWORD ниже)
DATABASE_URL=postgresql+asyncpg://skyhub:skyhub@localhost:5432/skyhub

# Только для Docker-варианта: пароль контейнера PostgreSQL. Если не
# задать, docker-compose.yml использует пароль по умолчанию ("skyhub") --
# наружу порт БД не смотрит (виден только контейнеру бота), но задать
# свой всё равно стоит, если сервер не изолирован от других жильцов.
POSTGRES_PASSWORD=

# Опционально: ID тестового сервера для мгновенной синхронизации
# slash-команд во время разработки. Оставьте пустым, чтобы
# синхронизировать только глобально (распространение может занять до часа).
DEV_GUILD_ID=

LOG_LEVEL=INFO
LOG_JSON=true
DEFAULT_LOCALE=ru

DB_POOL_SIZE=5
DB_ECHO=false

